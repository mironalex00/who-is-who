<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/schema/11.4.xsd"
         backupGlobals="false"
         backupStaticProperties="false"
         bootstrap="vendor/autoload.php"
         colors="true"
         stopOnError="true"
         stopOnFailure="true"
         stopOnDefect="true"
         processIsolation="false"
         cacheResult="false"
         executionOrder="size"
         resolveDependencies="true"
         displayDetailsOnIncompleteTests="true"
         displayDetailsOnSkippedTests="true"
         testdox="true"
>
    <testsuites>
        <testsuite name="Application game answer classes">
            <directory>tests/Game/Answers</directory>
        </testsuite>
        <testsuite name="Application game color enums">
            <directory>tests/Game/Colors</directory>
        </testsuite>
        <testsuite name="Application game character class">
            <directory>tests/Game/Character</directory>
        </testsuite>
        <testsuite name="Application game player classes">
            <directory>tests/Game/Player</directory>
        </testsuite>
        <testsuite name="Application game questions class">
            <directory>tests/Game/Questions</directory>
        </testsuite>
        <testsuite name="Application shared classes">
            <directory>tests/Shared</directory>
        </testsuite>
    </testsuites>
    <!-- <source>
        <include>
            <directory>src</directory>
        </include>
    </source> -->
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- <env name="DB_CONNECTION" value="sqlite"/> -->
        <!-- <env name="DB_DATABASE" value=":memory:"/> -->
        <env name="MAIL_MAILER" value="array"/>
    </php>
