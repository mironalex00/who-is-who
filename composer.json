{
    "$schema": "https://getcomposer.org/schema.json",
    "authors": [
        {
            "name": "Alexandru Miron",
            "email": "60828762+mironalex00@users.noreply.github.com"
        }
    ],
    "description": "Juego multiplataforma, en línea y multijugador del famoso 'Quién es quién'",
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "name": "arm/who-is-who",
    "prefer-stable": true,
    "type": "project",
    "require": {
        "php": "^8.2",
        "doctrine/dbal": "^4.2",
        "doctrine/orm": "^3.3",
        "ramsey/uuid": "^4.7",
        "ramsey/uuid-doctrine": "^2.1"
    },
    "require-dev": {
        "doctrine/migrations": "^3.8",
        "fakerphp/faker": "^1.20",
        "phpunit/phpunit": "^11.0.0",
        "symfony/console": "^7.2"
    },
    "scripts": {
        "post-install-cmd": [
            "@tests"
        ],
        "tests": "./vendor/bin/phpunit"
    },
    "autoload": {
        "psr-4": {
            "Arm\\Game\\Entities\\": "src/Entity/Game",
            "Arm\\Game\\Contracts\\": "src/Interfaces/Domain/Game",
            "Arm\\Shared\\": "src/Shared",
            "Arm\\Contracts\\": "src/Interfaces/Domain",
            "Arm\\Contracts\\Shared\\": "src/Interfaces/Shared"
        },
        "files": [ ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}