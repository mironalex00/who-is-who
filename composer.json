{
    "$schema": "https://getcomposer.org/schema.json",
    "authors": [
        {
            "name": "Alexandru Miron",
            "email": "60828762+mironalex00@users.noreply.github.com"
        }
    ],
    "description": "Juego multiplataforma, en línea y multijugador del famoso 'Quién es quién'",
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "name": "arm/who-is-who",
    "prefer-stable": true,
    "type": "project",
    "require": {
        "php": "^8.2",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "phpunit/phpunit": "^11.0.1"
    },
    "scripts": {
        "post-install-cmd": [
            "@test"
        ],
        "tests": "./vendor/bin/phpunit"
    },
    "autoload": {
        "psr-4": {
            "Arm\\Game\\": "src/Classes/Game",
            "Arm\\Shared\\": "src/Classes/Shared",
            "Arm\\Enums\\": "src/Enums",
            "Arm\\Interfaces\\": "src/Interfaces"
        },
        "files": [ "src/main.php" ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}